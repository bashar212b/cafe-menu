rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // استبدل UID أدناه بمعرّف حساب الأدمن من Firebase Authentication.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "PpTmohjIhENzn46BOwquKYdTpsa2";
    }

    // الزوار يحتاجون قراءة المنيو فقط.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}